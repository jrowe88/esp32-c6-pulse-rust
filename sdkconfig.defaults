# ESP-IDF configuration overrides. Changing this file triggers a full ESP-IDF rebuild.

# Rust often needs a bit more main task stack than C (the default is 3.5 KB).
# Increase this further if you allocate large variables on the main task's stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# The defaults for these are also a little small for Rust.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# Default stack for threads spawned with std::thread::spawn. Prefer setting it per
# thread with std::thread::Builder::stack_size().
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096
